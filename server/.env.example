# Copy thanh .env khi chay local. Tren Render thi set o muc Environment.
API_KEY=doi-key-nay-thanh-mot-chuoi-bi-mat
MAX_ORDERS=100
# Neu gan Persistent Disk tren Render, tro file luu don vao disk:
# DATA_FILE=/var/data/orders.json

# --- Nhan tin "dang giao hang" khi bam Xong (qua n8n webhook) ---
# URL webhook cua node n8n se gui tin Messenger. Bo trong = tat tinh nang.
N8N_DELIVERY_WEBHOOK_URL=https://<your-n8n>/webhook/fubao-delivery
# (Tuy chon) Doi noi dung tin nhan ma khong can sua code:
# DELIVERY_MESSAGE=Bếp đang trên đường giao hàng, mình xuống sảnh nhận cơm giúp em nha
